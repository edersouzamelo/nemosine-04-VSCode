generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  threads       Thread[]        // Added for chat isolation
  memories      UserMemory[]    // Added for persistent AI learning
  profileNodes  UserProfileNode[]
  personaConversationEpisodes PersonaConversationEpisode[]
  activeTopics  ActiveTopic[]
  termsAcceptances TermsAcceptance[]

  // Optional for WebAuthn support
  Authenticator Authenticator[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ThreadMode {
  SINGLE
  COLLECTIVE
}

enum ThreadPersonaRole {
  HOST
  GUEST
}

enum MessageKind {
  USER
  PERSONA
  SYSTEM_EVENT
}

enum GenerationStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
}

enum PersonaEpisodeVisibilityPolicy {
  SHARED
  PERSONA_PRIVATE
  CONFESSOR_SEALED
}

enum UserProfileEpistemicType {
  DECLARED_FACT
  OBSERVED_BEHAVIOR
  INFERRED_PATTERN
  USER_PREFERENCE
  GOAL
  VALUE
  RELATIONSHIP
  PROJECT
  CONSTRAINT
  HYPOTHESIS
  PUBLIC_SOURCE_CANDIDATE
}

enum UserProfileStatus {
  CANDIDATE
  CONFIRMED
  REJECTED
  SUPERSEDED
  EXPIRED
  DELETED
}

enum UserProfileSensitivity {
  PUBLIC
  NORMAL
  PERSONAL
  SENSITIVE
  CONFESSOR_ONLY
}

enum UserProfileScopeType {
  GLOBAL
  AUTHORIZED_PERSONAS
  PERSONA_SPECIFIC
  CONFESSOR
  SYSTEM
  NON_PROJECTABLE
}

model TermsAcceptance {
  id            String   @id @default(cuid())
  userId        String
  termsVersion  String
  acceptedAt    DateTime @default(now())
  ipApprox      String?
  sessionRecord String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([acceptedAt])
}
 
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}

model Thread {
  id        String    @id @default(cuid())
  userId    String
  personaId String
  placeId   String?
  mode      ThreadMode @default(SINGLE)
  title     String
  messages  Message[]
  participants ThreadPersonaPresence[]
  episodes  PersonaConversationEpisode[]
  generationAudits CollectiveGenerationAudit[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, personaId])
  @@index([userId, placeId])
  @@index([userId, mode])
}

model Message {
  id               String   @id @default(cuid())
  threadId         String
  role             String   // 'user' | 'assistant' | 'system'
  content          String
  speakerPersonaId String?
  turnGroupId      String?
  messageKind      MessageKind?
  generationStatus GenerationStatus?
  timestamp        DateTime @default(now())

  thread           Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, turnGroupId])
  @@index([threadId, speakerPersonaId])
  @@index([messageKind])
  @@index([generationStatus])
}

model ThreadPersonaPresence {
  id        String   @id @default(cuid())
  threadId  String
  personaId String
  role      ThreadPersonaRole
  joinedAt  DateTime @default(now())
  leftAt    DateTime?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([personaId])
  @@index([active])
  @@index([threadId, active])
  @@index([threadId, personaId, active])
}

model PersonaConversationEpisode {
  id               String   @id @default(cuid())
  userId           String
  personaId        String
  threadId         String
  turnGroupId      String?
  content          String
  sourceHash       String
  visibilityPolicy PersonaEpisodeVisibilityPolicy
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread           Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, personaId, sourceHash])
  @@index([userId, personaId, createdAt])
  @@index([threadId, turnGroupId])
  @@index([visibilityPolicy])
}

model CollectiveGenerationAudit {
  id                   String   @id @default(cuid())
  userId               String
  threadId             String
  turnGroupId          String
  personaId            String
  participantRole      ThreadPersonaRole
  generationStatus     GenerationStatus
  latencyMs            Int
  model                String
  tokens               Json?
  memoryWrites         Int      @default(0)
  filteredHistoryCount Int      @default(0)
  errorCode            String?
  createdAt            DateTime @default(now())

  thread               Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, turnGroupId])
  @@index([personaId])
  @@index([generationStatus])
  @@index([createdAt])
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  personaId String?  // Optional: If a specific persona learned it
  content   String   // The extracted fact
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfileNode {
  id                 String                    @id @default(cuid())
  userId             String
  normalizedContent  String
  shortSummary       String
  category           String
  subtype            String?
  epistemicType      UserProfileEpistemicType
  sourceType         String
  sourceReference    String?
  sourceDate         DateTime?
  capturedAt         DateTime                  @default(now())
  confidence         Float                     @default(0.5)
  sensitivity        UserProfileSensitivity    @default(NORMAL)
  scopeType          UserProfileScopeType      @default(GLOBAL)
  authorizedPersonas Json?
  status             UserProfileStatus         @default(CANDIDATE)
  validFrom          DateTime?
  validUntil         DateTime?
  createdBy          String
  updatedAt          DateTime                  @updatedAt
  removedAt          DateTime?

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence           UserProfileEvidence[]

  @@index([userId, status, updatedAt])
  @@index([userId, category, status])
  @@index([userId, epistemicType, status])
  @@index([userId, sensitivity, status])
  @@index([scopeType])
}

model UserProfileEvidence {
  id                String          @id @default(cuid())
  profileNodeId     String
  sourceType        String
  sourceId          String?
  redactedSummary   String?
  contentHash       String?
  evidenceWeight    Float           @default(0.5)
  evidenceDate      DateTime?
  origin            String?
  allowedAccess     Json?
  createdAt         DateTime         @default(now())

  profileNode       UserProfileNode  @relation(fields: [profileNodeId], references: [id], onDelete: Cascade)

  @@index([profileNodeId])
  @@index([sourceType, sourceId])
  @@index([contentHash])
}

model CognitiveFoundationAudit {
  id             String   @id @default(cuid())
  userIdHash     String
  threadIdHash   String?
  personaId      String?
  feature        String
  mode           String
  eventType      String
  status         String
  metrics        Json
  findingCodes   Json
  contentHashes  Json
  contentLengths Json
  privateRun     Boolean  @default(false)
  metadataOnly   Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([feature, eventType, createdAt])
  @@index([mode, createdAt])
  @@index([personaId, createdAt])
  @@index([privateRun, createdAt])
}

model ActiveTopic {
  id              String    @id @default(cuid())
  userId          String
  title           String
  summary         String
  keywords        Json?
  salience        Float     @default(0.5)
  status          String    @default("ACTIVE")
  privacyScope    String    @default("PUBLIC")
  sourceThreadId  String?
  sourcePersonaId String?
  firstObservedAt DateTime  @default(now())
  lastObservedAt  DateTime  @updatedAt
  resolvedAt      DateTime?
  evidenceCount   Int       @default(1)
  metadata        Json?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, lastObservedAt])
  @@index([userId, privacyScope, lastObservedAt])
}

model CognitiveRunAudit {
  id                 String   @id
  userIdHash         String   @map("user_id_hash")
  threadIdHash       String   @map("thread_id_hash")
  personaId          String   @map("persona_id")
  placeId            String?  @map("place_id")
  runtimeMode        String   @map("runtime_mode")
  executionProfile   String   @map("execution_profile")
  stateTransitions   Json     @map("state_transitions")
  auditEvents        Json     @map("audit_events")
  deliveryStatus     String   @default("not_attempted") @map("delivery_status")
  sideEffectStatus   String   @default("none") @map("side_effect_status")
  memoryEffectCount  Int      @default(0) @map("memory_effect_count")
  registryEffectCount Int     @default(0) @map("registry_effect_count")
  destinyEffectCount Int      @default(0) @map("destiny_effect_count")
  assistantMessagePersisted Boolean @default(false) @map("assistant_message_persisted")
  auditPersisted     Boolean  @default(false) @map("audit_persisted")
  iterationCount     Int      @map("iteration_count")
  coherence          Float?
  dimensionScores    Json     @map("dimension_scores")
  findingCodes       Json     @map("finding_codes")
  promotionDecision  String   @map("promotion_decision")
  failureReason      String?  @map("failure_reason")
  latencyPerStageMs  Json     @map("latency_per_stage_ms")
  modelIdentifiers   Json     @map("model_identifiers")
  promptHashes       Json     @map("prompt_hashes")
  contentHashes      Json     @map("content_hashes")
  contentLengths     Json     @map("content_lengths")
  privateRun         Boolean  @default(false) @map("private_run")
  metadataOnly       Boolean  @default(true) @map("metadata_only")
  createdAt          DateTime @default(now()) @map("created_at")
  completedAt        DateTime @map("completed_at")
  finalStatus        String   @default("UNKNOWN") @map("final_status")

  @@index([personaId])
  @@index([runtimeMode])
  @@index([createdAt])
  @@map("cognitive_run_audits")
}
