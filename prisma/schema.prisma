generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
 
model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  threads       Thread[]        // Added for chat isolation
  memories      UserMemory[]    // Added for persistent AI learning
  termsAcceptances TermsAcceptance[]

  // Optional for WebAuthn support
  Authenticator Authenticator[]
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TermsAcceptance {
  id            String   @id @default(cuid())
  userId        String
  termsVersion  String
  acceptedAt    DateTime @default(now())
  ipApprox      String?
  sessionRecord String?
  userAgent     String?
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([acceptedAt])
}
 
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
 
model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
}
 
// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@id([userId, credentialID])
}

model Thread {
  id        String    @id @default(cuid())
  userId    String
  personaId String
  title     String
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  role      String   // 'user' | 'assistant' | 'system'
  content   String
  timestamp DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
}

model UserMemory {
  id        String   @id @default(cuid())
  userId    String
  personaId String?  // Optional: If a specific persona learned it
  content   String   // The extracted fact
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PersonaManuscriptEvent {
  id               String    @id
  userId           String    @map("user_id")
  type             String
  sourceModule     String    @map("source_module")
  sourceEntityType String?   @map("source_entity_type")
  sourceEntityId   String?   @map("source_entity_id")
  factualSummary   String    @map("factual_summary")
  metadataJson     String    @default("{}") @map("metadata_json")
  sensitivity      String    @default("internal")
  importanceScore  Int       @default(50) @map("importance_score")
  status           String    @default("pending")
  occurredAt       DateTime  @default(now()) @map("occurred_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  processedAt      DateTime? @map("processed_at")
  excludedReason   String?   @map("excluded_reason")

  @@index([userId])
  @@index([occurredAt])
  @@index([processedAt])
  @@index([sourceModule])
  @@index([sourceEntityId])
  @@map("persona_manuscript_events")
}

model PersonaManuscript {
  id                  String   @id
  userId              String   @map("user_id")
  personaId           String   @map("persona_id")
  dateKey             String   @map("date_key")
  title               String?
  body                String
  entryType           String   @map("entry_type")
  tone                String
  confidence          Float    @default(0)
  interpretationLevel String   @default("mixed") @map("interpretation_level")
  salienceScore       Int      @default(0) @map("salience_score")
  isPinned            Boolean  @default(false) @map("is_pinned")
  isRead              Boolean  @default(false) @map("is_read")
  isHidden            Boolean  @default(false) @map("is_hidden")
  generationVersion   String   @default("v1") @map("generation_version")
  idempotencyKey      String   @unique @map("idempotency_key")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @map("updated_at")

  @@index([userId])
  @@index([personaId])
  @@index([dateKey])
  @@map("persona_manuscripts")
}

model PersonaManuscriptSource {
  id           String @id
  manuscriptId String @map("manuscript_id")
  eventId      String @map("event_id")

  @@index([manuscriptId])
  @@index([eventId])
  @@map("persona_manuscript_sources")
}

model PersonaManuscriptPreference {
  id                String   @id
  userId            String   @map("user_id")
  personaId         String   @map("persona_id")
  enabled           Boolean  @default(true)
  sourceModulesJson String   @default("[]") @map("source_modules_json")
  minimumSalience   Int      @default(35) @map("minimum_salience")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @map("updated_at")

  @@unique([userId, personaId])
  @@map("persona_manuscript_preferences")
}

model PersonaManuscriptSetting {
  userId                   String   @id @map("user_id")
  enabled                  Boolean  @default(true)
  frequency                String   @default("equilibrada")
  notificationsEnabled     Boolean  @default(false) @map("notifications_enabled")
  allowedSourceModulesJson String   @default("[\"agenda\",\"destiny-line\",\"registros\",\"projects\",\"tasks\",\"persona-chat\",\"system\"]") @map("allowed_source_modules_json")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @default(now()) @map("updated_at")

  @@map("persona_manuscript_settings")
}

model PersonaManuscriptGeneration {
  id             String    @id
  userId         String    @map("user_id")
  dateKey        String    @map("date_key")
  status         String
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  errorCode      String?   @map("error_code")
  generatedCount Int       @default(0) @map("generated_count")
  idempotencyKey String    @unique @map("idempotency_key")

  @@index([userId, dateKey])
  @@map("persona_manuscript_generations")
}

model CognitiveRunAudit {
  id                 String   @id
  userIdHash         String   @map("user_id_hash")
  threadIdHash       String   @map("thread_id_hash")
  personaId          String   @map("persona_id")
  placeId            String?  @map("place_id")
  runtimeMode        String   @map("runtime_mode")
  executionProfile   String   @map("execution_profile")
  stateTransitions   Json     @map("state_transitions")
  iterationCount     Int      @map("iteration_count")
  coherence          Float?
  dimensionScores    Json     @map("dimension_scores")
  findingCodes       Json     @map("finding_codes")
  promotionDecision  String   @map("promotion_decision")
  failureReason      String?  @map("failure_reason")
  latencyPerStageMs  Json     @map("latency_per_stage_ms")
  modelIdentifiers   Json     @map("model_identifiers")
  promptHashes       Json     @map("prompt_hashes")
  contentHashes      Json     @map("content_hashes")
  privateRun         Boolean  @default(false) @map("private_run")
  metadataOnly       Boolean  @default(true) @map("metadata_only")
  createdAt          DateTime @default(now()) @map("created_at")
  completedAt        DateTime @map("completed_at")

  @@index([personaId])
  @@index([runtimeMode])
  @@index([createdAt])
  @@map("cognitive_run_audits")
}
